; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bike"
config/version="1.0.0"
config/tags=PackedStringArray("game_jam")
run/main_scene="uid://540i6fis2ofd"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://cbl8xpimdbwbd"
config/icon="uid://cbvs5e3lg61nb"
boot_splash/minimum_display_time=500

[audio]

buses/default_bus_layout="uid://dutgij4isxbpu"

[autoload]

EventBus="*uid://d24y5m17lkgok"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://common/": "gray",
"res://entities/": "blue",
"res://environment/": "purple",
"res://gui/": "green",
"res://levels/": "orange"
}

